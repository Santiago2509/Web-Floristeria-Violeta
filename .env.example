# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Project → Settings → Environment Variables.

# --- Supabase (base de datos) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave privada (solo servidor) para que el panel admin pueda escribir.
# Con ella configurada puedes bloquear con RLS las escrituras públicas.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (subida de fotos desde el panel admin) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Panel de administrador ---
# Contraseña para entrar en /admin
ADMIN_PASSWORD=
# Secreto aleatorio de al menos 32 caracteres para firmar la sesión
# (genera uno con: openssl rand -base64 32)
ADMIN_SESSION_SECRET=

# --- WhatsApp (opcional, formato internacional sin "+") ---
NEXT_PUBLIC_WHATSAPP_NUMBER=573215079305
